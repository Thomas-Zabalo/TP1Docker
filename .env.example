# Application stack
HTTP_PORT=80
BACKEND_DATA_DIR=./backend_data

# Resource limits for the application stack
NGINX_CPUS=0.25
NGINX_MEMORY=128M
FRONTEND_CPUS=0.50
FRONTEND_MEMORY=256M
BACKEND_CPUS=1.0
BACKEND_MEMORY=512M

# Resource limits for CI services
CI_LINT_CPUS=1.0
CI_LINT_MEMORY=1G
CI_TEST_CPUS=0.50
CI_TEST_MEMORY=512M
